# Copy to .env. docker-compose.yml reads it for core and agent. Secrets live here, never in the database.

# Shared secret between core and agent (X-Service-Token)
SERVICE_TOKEN=change-me-service-token
DB_PASSWORD=blacktax
# JHipster JWT signing key (base64, ≥ 512 bits). Generate: openssl rand -base64 64 | tr -d '\n'
# JWT_BASE64_SECRET=   (required in production; the dev profile has a sample key)

# Demo conveniences (core dev profile): seed data, /api/dev/* endpoints, fixed OTP 123456
BLACKTAX_SEED=true
BLACKTAX_DEV_ENDPOINTS=true
OTP_FIXED_CODE=123456

# Stitch (DebiCheck). mock = local rail that sends signed webhooks to core; live = Stitch GraphQL.
STITCH_MODE=mock
STITCH_WEBHOOK_SECRET=change-me-webhook-secret
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=
PUBLIC_URL=http://localhost:8080

# Arc Testnet via Circle developer-controlled wallets. Leave blank to use the mock rail.
ARC_MODE=
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
ARC_LENDER_WALLET_ID=
ARC_LENDER_ADDRESS=
ARC_BORROWER_ADDRESS=
# Borrower stokvel's Circle wallet: only the provider may call setBudget, and it signs submit
ARC_BORROWER_WALLET_ID=
# Defaults are the live Arc Testnet values (docs.arc.io). Override only if they change.
# ARC_ESCROW_ADDRESS=0x0747EEf0706327138c69792bF28Cd525089e4583
# ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
# ARC_RPC_URL=https://rpc.testnet.arc.io
# ARC_EXPLORER_TX_URL=https://explorer.testnet.arc.io/tx/
# Deadline to disburse (after it anyone can claimRefund to the lender), and whether to release right away
ARC_DISBURSE_WINDOW_SECONDS=86400
ARC_AUTO_DISBURSE=true
# ZAR → USDC conversion, and a scale so faucet-sized balances can fund rand-sized demo loans
ZAR_PER_USDC=18.00
ARC_DEMO_SCALE=0.001

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api
# Demo bar and OTP hint in the UI (needs the core dev profile for its one-click sign-in)
NEXT_PUBLIC_DEMO=false
